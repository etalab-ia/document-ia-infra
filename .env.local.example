# Copier ce fichier vers `.env.local` (ignoré par Git, chmod 600)
# OU laisser `nix develop` vous demander ces valeurs interactivement au 1er lancement.
#
# IMPORTANT Scaleway : votre clé API IAM personnelle DOIT avoir le projet "DocumentIA"
# défini comme "Preferred Project for Object Storage" (default_project_id) afin que
# le backend S3 Pulumi puisse accéder au bucket de state.

SCW_ACCESS_KEY="SCWXXXXXXXXXXXXXXXXX"
SCW_SECRET_KEY="00000000-0000-0000-0000-000000000000"
SCW_DEFAULT_PROJECT_ID="00000000-0000-0000-0000-000000000000"
