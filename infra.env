# =============================================================================
# Configuration publique (non sensible) de l'infrastructure Document IA
# =============================================================================
# Ce fichier est versionné dans Git : AUCUN secret ni identifiant interne DINUM
# ne doit y figurer.
# - SCW_DEFAULT_PROJECT_ID est auto-découvert via la clé API (ou stocké dans .env.local).
# - PULUMI_STATE_BUCKET et PULUMI_CONFIG_PASSPHRASE sont chargés depuis Scaleway Secret Manager.

SCW_DEFAULT_REGION="fr-par"
SCW_DEFAULT_ZONE="fr-par-1"

# Référence du secret Scaleway Secret Manager (type: key_value) contenant
# les variables communes d'infra (PULUMI_STATE_BUCKET, PULUMI_CONFIG_PASSPHRASE, etc.)
SCW_VAULT_SECRET_PATH="/pulumi"
SCW_VAULT_SECRET_NAME="config"
